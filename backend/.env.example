# Environment Variables for Lyft Zone Backend
# Copy this file to .env and update values as needed

PORT=5000
DATABASE_URL=./database.sqlite
NODE_ENV=development

# AI Weekly Plan Builder V1 review (production-ready only when enabled)
ENABLE_AI_WEEKLY_PLAN_REVIEW=false

# Local initial-generation diagnostics (always disabled in production)
ENABLE_AI_WEEKLY_PLAN_DEBUG_ARTIFACTS=false
OPENAI_MODEL_PROGRAM_REVIEW=
OPENAI_PROGRAM_REVIEW_TIMEOUT_MS=60000
OPENAI_PROGRAM_REVIEW_MAX_OUTPUT_TOKENS=4000

# AI Weekly Plan Builder V1 repair provider (orchestration added in Phase 7C)
ENABLE_AI_WEEKLY_PLAN_REPAIR=false
OPENAI_MODEL_PROGRAM_REPAIR=
OPENAI_PROGRAM_REPAIR_TIMEOUT_MS=120000
OPENAI_PROGRAM_REPAIR_MAX_OUTPUT_TOKENS=24000

# Local simple Weekly Plan pipeline (three isolated calls)
OPENAI_SIMPLE_WEEKLY_PLAN_MODEL_1=gpt-5.4-mini
OPENAI_SIMPLE_WEEKLY_PLAN_MODEL_2=gpt-4.1-mini
OPENAI_SIMPLE_WEEKLY_PLAN_MODEL_3=gpt-4.1-mini
OPENAI_SIMPLE_WEEKLY_PLAN_TIMEOUT_1_MS=120000
OPENAI_SIMPLE_WEEKLY_PLAN_TIMEOUT_2_MS=60000
OPENAI_SIMPLE_WEEKLY_PLAN_TIMEOUT_3_MS=120000
OPENAI_SIMPLE_WEEKLY_PLAN_MAX_OUTPUT_TOKENS_1=16000
OPENAI_SIMPLE_WEEKLY_PLAN_MAX_OUTPUT_TOKENS_2=3000
OPENAI_SIMPLE_WEEKLY_PLAN_MAX_OUTPUT_TOKENS_3=24000
