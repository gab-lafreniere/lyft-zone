# Environment Variables for Lyft Zone Backend
# Copy this file to .env and update values as needed

PORT=5000
DATABASE_URL=./database.sqlite
NODE_ENV=development

# Local simple Weekly Plan pipeline (two calls plus optional field fallback)
SIMPLE_WEEKLY_PLAN_DETERMINISTIC_FILLS_ENABLED=true

# Bound Plan migration.
#   SIMPLE_WEEKLY_PLAN_EXTRACTION_MODE: GEOMETRY_ONLY (current production path and
#     rollback target) | BOUND_PLAN (Call #2 binds the plan Call #1 created)
#   SIMPLE_WEEKLY_PLAN_RECOVERY_LEVEL: OFF (fail closed, same posture as today)
#     | BINDER_ONLY (retry Call #2) | FULL (also allows one Call #1 repair)
SIMPLE_WEEKLY_PLAN_EXTRACTION_MODE=GEOMETRY_ONLY
SIMPLE_WEEKLY_PLAN_RECOVERY_LEVEL=OFF
OPENAI_SIMPLE_WEEKLY_PLAN_MODEL_1=gpt-5.4-mini
OPENAI_SIMPLE_WEEKLY_PLAN_MODEL_2=gpt-5.4-mini
OPENAI_SIMPLE_WEEKLY_PLAN_MODEL_3=gpt-4.1-mini
OPENAI_SIMPLE_WEEKLY_PLAN_TIMEOUT_1_MS=60000
OPENAI_SIMPLE_WEEKLY_PLAN_TIMEOUT_2_MS=90000
OPENAI_SIMPLE_WEEKLY_PLAN_TIMEOUT_3_MS=180000
OPENAI_SIMPLE_WEEKLY_PLAN_MAX_OUTPUT_TOKENS_1=16000
OPENAI_SIMPLE_WEEKLY_PLAN_MAX_OUTPUT_TOKENS_2=8000
OPENAI_SIMPLE_WEEKLY_PLAN_MAX_OUTPUT_TOKENS_3=24000
